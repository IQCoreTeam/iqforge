# ── Demo mode ────────────────────────────────────────────────────────────────
# 1 = publish/domain steps simulate success (no wallet funds needed, nothing
#     written onchain). Perfect for trying the flow.
# 0 = REAL MODE: publishing writes your site onchain via IQLabs (costs SOL tx
#     fees + IQ protocol fee) and domain-attach writes a real SNS record.
NEXT_PUBLIC_IQ_MOCK=1

# Recommended for real mode: your own RPC (public mainnet RPC rate-limits hard).
# NEXT_PUBLIC_RPC=https://your-rpc-url

# Optional: use a different IQ gateway for "Live" links (default below).
# NEXT_PUBLIC_IQ_GATEWAY=https://gateway.iqlabs.dev
